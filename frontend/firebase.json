{
  "hosting": {
    "public": "dist",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "/api/**",
        "run": {
          "serviceId": "api-gateway",
          "region": "asia-south2"
        }
      },
      {
        "source": "/oauth2/authorization/**",
        "run": {
          "serviceId": "api-gateway",
          "region": "asia-south2"
        }
      },
      {
        "source": "/login/oauth2/**",
        "run": {
          "serviceId": "api-gateway",
          "region": "asia-south2"
        }
      },
      {
        "source": "**",
        "destination": "/index.html"
      }
    ],
    "headers": [
      {
        "source": "/index.html",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, no-store, must-revalidate"
          }
        ]
      }
    ]
  }
}

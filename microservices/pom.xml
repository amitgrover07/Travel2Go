<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>org.springframework.boot</groupId>
		<artifactId>spring-boot-starter-parent</artifactId>
		<version>4.1.0</version>
		<relativePath/>
	</parent>
	<groupId>com.travel2go</groupId>
	<artifactId>travel2go-microservices</artifactId>
	<version>0.0.1-SNAPSHOT</version>
	<packaging>pom</packaging>
	<name>travel2go-microservices</name>
	<description>Shared parent for the Travel2Go microservices fleet - centralizes Java/Spring Boot/Spring Cloud versions so every module upgrades together instead of drifting</description>

	<properties>
		<java.version>25</java.version>
		<spring-cloud.version>2025.1.3</spring-cloud.version>
		<spring-cloud-gcp.version>8.2.1</spring-cloud-gcp.version>
		<lombok.version>1.18.48</lombok.version>
		<jjwt.version>0.13.0</jjwt.version>
		<testcontainers.version>2.0.5</testcontainers.version>
	</properties>

	<dependencyManagement>
		<dependencies>
			<dependency>
				<groupId>org.springframework.cloud</groupId>
				<artifactId>spring-cloud-dependencies</artifactId>
				<version>${spring-cloud.version}</version>
				<type>pom</type>
				<scope>import</scope>
			</dependency>
			<dependency>
				<groupId>com.google.cloud</groupId>
				<artifactId>spring-cloud-gcp-dependencies</artifactId>
				<version>${spring-cloud-gcp.version}</version>
				<type>pom</type>
				<scope>import</scope>
			</dependency>
			<dependency>
				<groupId>org.testcontainers</groupId>
				<artifactId>testcontainers-bom</artifactId>
				<version>${testcontainers.version}</version>
				<type>pom</type>
				<scope>import</scope>
			</dependency>
		</dependencies>
	</dependencyManagement>

	<modules>
		<module>common-models</module>
		<module>platform-security</module>
		<module>identity-service</module>
		<module>package-service</module>
		<module>media-service</module>
		<module>notification-service</module>
		<module>booking-service</module>
		<module>trip-service</module>
		<module>payment-service</module>
		<module>reactive-booking-function</module>
		<module>api-gateway</module>
	</modules>
</project>
